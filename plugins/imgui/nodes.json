 {
  "id": "flags_or",
  "label": "Combine flags (a | b)",
  "category": "Dear ImGui: values",
  "description": "Bitwise OR of two flag values, e.g. ImGuiWindowFlags_NoTitleBar | ImGuiWindowFlags_NoResize. Chain several nodes for more.",
  "inputs": [
   {
    "id": "a",
    "type": "",
    "label": "a",
    "default": "0"
   },
   {
    "id": "b",
    "type": "",
    "label": "b",
    "default": "0"
   }
  ],
  "output": {
   "type": "int",
   "label": "flags"
  },
  "template": "($a | $b)"
 },
 {
  "id": "address",
  "label": "Address of (&variable)",
  "category": "Dear ImGui: values",
  "description": "Pointer to a variable, for the widgets that edit a value in place (Checkbox, SliderFloat, InputInt...). Type the name of a variable (global or local).",
  "fields": [
   {
    "key": "var",
    "label": "Variable",
    "kind": "var"
   }
  ],
  "output": {
   "type": "",
   "label": "pointer"
  },
  "template": "&@var"
 },
 {
