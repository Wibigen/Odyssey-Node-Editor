[
 {
  "id": "add_draw",
  "label": "Add draw function",
  "category": "Dear ImGui",
  "description": "Registers a function of yours (graph \"Define function\", no arguments, returns void) that is called every frame to draw the ImGui UI. Placed once in exl_main: no execution pins. Also installs the ImGui hooks.",
  "place": "main",
  "flow": true,
  "fields": [
   {
    "key": "function",
    "label": "Draw function",
    "kind": "func",
    "hint": "name of a function defined in the graph"
   }
  ],
  "template": "nvnImGui::addDrawFunc(@function)",
  "init": [
   "nvnImGui::InstallHooks();"
  ],
  "includes": [
   "\"imgui_backend/imgui_impl_nvn.hpp\"",
   "\"imgui_nvn.h\"",
   "\"imgui.h\""
  ]
 },
 {
  "id": "vec2",
  "label": "ImVec2 (x, y)",
  "category": "Dear ImGui: values",
  "description": "A 2D vector (sizes, positions).",
  "inputs": [
   {
    "id": "x",
    "type": "float",
    "label": "x",
    "default": "0.0f"
   },
   {
    "id": "y",
    "type": "float",
    "label": "y",
    "default": "0.0f"
   }
  ],
  "output": {
   "type": "ImVec2",
   "label": "vector"
  },
  "template": "ImVec2($x, $y)",
  "includes": [
   "\"imgui.h\""
  ]
 },
 {
