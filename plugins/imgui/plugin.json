{
  "id": "imgui",
  "title": "Dear ImGui",
  "author": "WibiDev",
  "version": "1.3.0",
  "icon": "icon.png",
  "default_enabled": false,
  "description": "Immediate-mode UI inside the game (Dear ImGui 1.90.6 by Omar Cornut) for your exlaunch mod. Adds ~350 ImGui functions, the ImDrawList methods and ~500 constants as nodes (browse them with Edit > Add plugin function), plus 'Add draw function'. When you enable it, the editor offers to add ImGui to your exlaunch base (copy-if-missing + a marked CMake block, revertible). Backend based on CraftyBoss' SMO-Exlaunch-Base, adapted to bases that use OdysseyHeaders (like Fuzzy2319's SMO-Exlaunch-Base). Includes the template 'Hello ImGui'.",
  "catalog": "functions.json",
  "templates": [
    {
      "name": "Hello ImGui",
      "file": "templates/hello_imgui.odn",
      "description": "Loads ImGui and shows a window with a text and a button that counts presses."
    }
  ],
  "base": {
    "title": "Dear ImGui on the exlaunch base",
    "payload": "base",
    "exact": [
      "imgui/"
    ],
    "cmake": {
      "target": "auto",
      "definitions": [
        "IMGUI_USER_CONFIG=\"imgui_backend/nvn_imgui_config.h\""
      ],
      "include_dirs": [
        "imgui",
        "src",
        "src/program",
        "include",
        "include/NintendoSDK",
        "include/NintendoSDK/nvn",
        "include/NintendoSDK/nvnTool",
        "libs/NintendoSDK",
        "libs/NintendoSDK/nvnTool"
      ],
      "glob_sources": [
        "imgui/*.cpp"
      ],
      "embed": [
        "romfs/ShaderData/imgui.bin"
      ]
    },
    "settings": {
      "title": "Gamepad",
      "file": "src/odn_imgui_config.h",
      "template": "#pragma once\n// Generated by the Odyssey Node Editor (Plugin explorer > Dear ImGui > Exlaunch base). Change the choices there, not here.\n#define ODN_PAD_MODE $pad_mode\n#define ODN_PAD_HOLD $pad_hold\n#define ODN_PAD_PRESS $pad_press\n",
      "fields": [
        {
          "id": "pad_mode",
          "label": "Controller",
          "default": "1",
          "options": [
            [
              "1",
              "Combo: give the controller to ImGui with two buttons"
            ],
            [
              "2",
              "Automatic: ImGui has the controller while one of its windows is shown"
            ],
            [
              "0",
              "Never: ImGui never takes the controller (mouse and keyboard only)"
            ]
          ]
        },
        {
          "id": "pad_hold",
          "label": "Hold",
          "default": "ZL",
          "options": [
            [
              "ZL",
              "ZL"
            ],
            [
              "ZR",
              "ZR"
            ],
            [
              "L",
              "L"
            ],
            [
              "R",
              "R"
            ],
            [
              "A",
              "A"
            ],
            [
              "B",
              "B"
            ],
            [
              "X",
              "X"
            ],
            [
              "Y",
              "Y"
            ],
            [
              "Plus",
              "+ (Plus)"
            ],
            [
              "Minus",
              "- (Minus)"
            ],
            [
              "Up",
              "D-pad up"
            ],
            [
              "Down",
              "D-pad down"
            ],
            [
              "Left",
              "D-pad left"
            ],
            [
              "Right",
              "D-pad right"
            ],
            [
              "StickL",
              "Left stick click"
            ],
            [
              "StickR",
              "Right stick click"
            ]
          ],
          "enabled_if": {
            "pad_mode": "1"
          }
        },
        {
          "id": "pad_press",
          "label": "then press",
          "default": "ZR",
          "options": [
            [
              "ZL",
              "ZL"
            ],
            [
              "ZR",
              "ZR"
            ],
            [
              "L",
              "L"
            ],
            [
              "R",
              "R"
            ],
            [
              "A",
              "A"
            ],
            [
              "B",
              "B"
            ],
            [
              "X",
              "X"
            ],
            [
              "Y",
              "Y"
            ],
            [
              "Plus",
              "+ (Plus)"
            ],
            [
              "Minus",
              "- (Minus)"
            ],
            [
              "Up",
              "D-pad up"
            ],
            [
              "Down",
              "D-pad down"
            ],
            [
              "Left",
              "D-pad left"
            ],
            [
              "Right",
              "D-pad right"
            ],
            [
              "StickL",
              "Left stick click"
            ],
            [
              "StickR",
              "Right stick click"
            ]
          ],
          "enabled_if": {
            "pad_mode": "1"
          }
        }
      ]
    }
  },
  "help": [
    {
      "title": "How to use Dear ImGui",
      "file": "help/using_imgui.md",
      "buttons": [
        {
          "label": "Load the Hello ImGui example",
          "do": "template:Hello ImGui"
        },
        {
          "label": "Open the function browser",
          "do": "browser:imgui"
        },
        {
          "label": "Project base…",
          "do": "base:imgui"
        }
      ]
    }
  ]
}